# Checks the server's certificate twice a day; lego renews it only when a third of its life is left. See
# hovanki-cert.service and docs/deploy.md, «Без Caddy».
[Unit]
Description=Check the Hovanki server's TLS certificate twice a day

[Timer]
OnCalendar=*-*-* 04,16:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
