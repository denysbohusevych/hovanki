# Updates the Hovanki server to the newest image of HOVANKI_TAG (.env; `main` follows every push to main) with
# hovanki-update.sh: pulls the image and, only when it is new, restarts the server. Only the server: Caddy is updated
# by hand. Started by hovanki-update.timer; see docs/deploy.md.
[Unit]
Description=Update the Hovanki server to the newest image of its tag
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# The docker group, the GHCR login from `docker login` (~/.docker/config.json) and /opt/hovanki belong to this user.
User=ubuntu
WorkingDirectory=/opt/hovanki
ExecStart=/usr/bin/bash /opt/hovanki/hovanki-update.sh
