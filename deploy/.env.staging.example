# /opt/hovanki/.env of the STAGING VM (docs/deploy.md, «Staging»; ADR 0018, §2). The same compose.yaml as production, its
# own VM, its own database `hovanki_staging` with its own role on the same RDS. Copy this file to the VM as `.env`,
# fill in the values, `chmod 600 .env`, check with `docker compose config --quiet`. Never commit a filled-in copy.
# The production VM's `.env` is described in docs/deploy.md, «Настройки (.env)»; it has none of the variables marked
# «staging» below.

# --- Name and image -------------------------------------------------------------------------------------------------
# The DuckDNS name of the staging VM; Caddy gets its certificate for it. The same address is the repository variable
# STAGING_SERVER_URL (https://<this name>) that preview.yml bakes into the tester builds. There is no Caddyfile:
# compose.yaml starts `caddy reverse-proxy --from $DOMAIN`.
DOMAIN=hovanki-staging.duckdns.org
# `main` follows every push to main through hovanki-update.timer. On the day of a test: stop the timer and pin the
# tested build, `sha-<commit>` (docs/deploy.md, «Staging», «День теста»).
HOVANKI_TAG=main

# --- Spring profile and memory (staging) ------------------------------------------------------------------------------
# Turns on application-staging.yaml: the limit of players per game (60), and what else staging needs.
SPRING_PROFILES_ACTIVE=staging
# The container's memory limit; the heap is 75% of it. 1g on a t3.small (2 GB), 2g on a t3.medium (4 GB, test day).
# The default of compose.yaml, 640m, is for the 1 GB production VM.
SERVER_MEM_LIMIT=1g

# --- Database (staging) ---------------------------------------------------------------------------------------------
# The same RDS as production, but another database and another role: the testers' data never mixes with the real one,
# and `DROP DATABASE hovanki_staging` removes all of it (docs/deploy.md, «Staging», «Удалить staging»).
DATABASE_HOST=hovanki.xxxxxxxxxxxx.eu-central-1.rds.amazonaws.com
DATABASE_NAME=hovanki_staging
DATABASE_USER=hovanki_staging
DATABASE_PASSWORD=<the password of the role hovanki_staging, openssl rand -hex 24>

# --- Email ----------------------------------------------------------------------------------------------------------
# The server refuses to start without an SMTP host and a sender. The mailbox of production can be reused: a field
# test is a few dozen codes (docs/deploy.md, «Почта»).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=hovanki.app@gmail.com
SPRING_MAIL_PASSWORD=abcdefghijklmnop
HOVANKI_MAIL_FROM=hovanki.app@gmail.com

# --- Admin ----------------------------------------------------------------------------------------------------------
# Staging has its own admin: its own accounts and its own key (base64 of 32 random bytes: openssl rand -base64 32).
# The feature flags of the test (FIELD_LOG, RADIO_LAB, LIVE_SOCKET, ...) are switched there (docs/deploy.md, «Админка»).
HOVANKI_ADMIN_SECRET_KEY=

# --- Sentry of the server (staging, optional) -------------------------------------------------------------------------
# The DSN of the server's Sentry project (region EU); empty: no Sentry. Production never gets one (ADR 0018, §7).
SENTRY_DSN=
