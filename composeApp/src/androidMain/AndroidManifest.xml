<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <!-- Keeps location updates flowing while the screen is off during a round. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- The ongoing "round in progress" notification of the foreground service and the hider's alerts (Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The seeker scans the hider's QR code; typing the digits works without a camera. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />

  <application>
    <service
      android:name="app.hovanki.client.tracking.LocationTrackingService"
      android:exported="false"
      android:foregroundServiceType="location" />
  </application>
</manifest>
