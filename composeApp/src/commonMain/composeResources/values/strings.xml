  <!-- The radar by Bluetooth and UWB (docs/adr/0012-nearby-radar.md) -->
  <string name="settings_features">Extras</string>
  <string name="settings_features_hint">All of them are off unless you turn them on. The server offers only what its operator has switched on.</string>
  <string name="settings_features_none">The server has no extras switched on yet.</string>
  <string name="settings_radar">Radar by Bluetooth</string>
  <string name="settings_radar_hint">The seekers feel «warm, hot, burning» when a hider is near. The phones exchange only a code that changes every few minutes; no location in it.</string>
  <string name="settings_radar_optional">Whoever has it</string>
  <string name="settings_radar_required">Everyone must</string>
  <string name="settings_radar_required_hint">The game starts only when every phone has Bluetooth on; a hider who turns it off is shown to the seekers after a minute.</string>
  <string name="settings_hider_sense">Hider’s sense</string>
  <string name="settings_hider_sense_hint">A hider’s phone buzzes when a seeker is close.</string>
  <string name="settings_proximity_catch">Catch only up close</string>
  <string name="settings_proximity_catch_hint">A claim goes through only when the radar heard the two phones next to each other.</string>
  <string name="settings_precision_radar">Precision radar (UWB)</string>
  <string name="settings_precision_radar_hint">Metres and an arrow between phones of one kind (iPhone with iPhone, Android with Android), while both players look at their phones.</string>
  <string name="settings_precision_for_hiders">Hiders see the arrow too</string>
  <string name="settings_fair_only">Only when everyone can</string>
  <string name="settings_activity">Running detector</string>
  <string name="settings_activity_hint">The phone tells when its player runs: for the «Sprint» quest and the statistics. Nothing leaves the phone but «running» or not.</string>
  <string name="settings_pocket_stealth">The pocket hides</string>
  <string name="settings_pocket_stealth_hint">The body damps the signal and the radar evens that out for everybody. With this on, a hider whose phone is in the pocket, screen off, reads a step colder to the seekers: want to be harder to feel, walk blind.</string>
